<Window x:Class="ConveniencePos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ConveniencePos.ViewModels"
        Title="Convenience POS" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        Closing="MainWindow_Closing">

    <Window.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A1A2E"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#CCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="PaymentButton" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2E86C1"/>
            <Setter Property="Padding" Value="20,14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B6CA8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#AAB7B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Barcode Input + Cart -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barcode Input -->
            <Border Grid.Row="0" Background="White" CornerRadius="8"
                    Padding="16,12" Margin="0,0,0,10"
                    BorderBrush="#DDD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#x1F4E6;" FontSize="28"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="0" Text="バーコード" FontSize="14"
                               Foreground="#888" VerticalAlignment="Top"
                               Margin="48,0,0,0"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="22"
                             Padding="10,10"
                             VerticalContentAlignment="Center"
                             x:Name="BarcodeTextBox">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Button Grid.Column="2" Content="検索"
                            Command="{Binding AddItemCommand}"
                            Style="{StaticResource PaymentButton}"
                            Background="#27AE60" FontSize="16"
                            Padding="16,10" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Cart DataGrid -->
            <Border Grid.Row="1" Background="White" CornerRadius="8"
                    BorderBrush="#DDD" BorderThickness="1">
                <DataGrid AutoGenerateColumns="False"
                          ItemsSource="{Binding CartItems}"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFC"
                          CanUserAddRows="False"
                          SelectionMode="Single">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#34495E"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="商品名" Binding="{Binding Name}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="Padding" Value="4,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="税率" Binding="{Binding TaxRate, StringFormat='{}{0}%'}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="TextAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="数量" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Quantity}"
                                               FontSize="15"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             MaxLength="4"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="単価" Binding="{Binding UnitPrice, StringFormat='¥{0:N0}'}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="小計" Binding="{Binding LineTotalWithTax, StringFormat='¥{0:N0}'}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="TextAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Right: Payment Panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="8"
                BorderBrush="#DDD" BorderThickness="1"
                Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="お会計" FontSize="22" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,20"/>

                <!-- 小計 -->
                <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="小計" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding Subtotal, StringFormat='¥{0:N0}'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </Border>

                <!-- 8%対象額 -->
                <Border Grid.Row="2" Background="#F8F9FA" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="8%対象額" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding TaxableAmount8, StringFormat='¥{0:N0}'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </Border>

                <!-- 8%消費税 -->
                <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="消費税 (8%)" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding TaxAmount8, StringFormat='¥{0:N0}'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </Border>

                <!-- 10%対象額 -->
                <Border Grid.Row="4" Background="#F8F9FA" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="10%対象額" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding TaxableAmount10, StringFormat='¥{0:N0}'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </Border>

                <!-- 10%消費税 -->
                <Border Grid.Row="5" Background="#F8F9FA" CornerRadius="6"
                        Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <TextBlock Text="消費税 (10%)" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Text="{Binding TaxAmount10, StringFormat='¥{0:N0}'}"
                                   Style="{StaticResource ValueStyle}"/>
                    </Grid>
                </Border>

                <!-- 合計金額 -->
                <Border Grid.Row="6" Background="#1A1A2E" CornerRadius="6"
                        Padding="14,14" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="合計" FontSize="18" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat='¥{0:N0}'}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#F39C12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- 預かり金額 -->
                <TextBlock Grid.Row="7" Text="預かり金額" FontSize="14"
                           Foreground="#555" Margin="0,4,0,6"/>
                <TextBox Grid.Row="7"
                         Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource InputStyle}"
                         VerticalContentAlignment="Center"
                         Margin="0,24,0,0"
                         x:Name="ReceivedAmountTextBox"/>

                <!-- お釣り -->
                <Border Grid.Row="7" Background="#EBF5FB" CornerRadius="6"
                        Padding="14,12" Margin="0,88,0,0">
                    <Grid>
                        <TextBlock Text="お釣り" Style="{StaticResource LabelStyle}"
                                   Foreground="#2E86C1"/>
                        <TextBlock Text="{Binding Change, StringFormat='¥{0:N0}'}"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#2E86C1"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"/>
                    </Grid>
                </Border>

                <!-- 会計確定ボタン -->
                <Button Grid.Row="8" Content="会計確定"
                        Command="{Binding ConfirmTransactionCommand}"
                        Style="{StaticResource PaymentButton}"
                        Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
