<Window x:Class="ConveniencePos.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ConveniencePos.ViewModels"
        Title="Convenience POS" Width="1100" Height="720"
        Background="#F0F2F5" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL -->
        <DockPanel Grid.Column="0" Margin="0,0,16,0">

            <!-- Barcode Input Area -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="8"
                    BorderBrush="#DDD" BorderThickness="1" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📦 バーコード" FontSize="14" Foreground="#888" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BarcodeTextBox" Grid.Column="0"
                                 FontSize="22" VerticalContentAlignment="Center"
                                 Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="BarcodeTextBox_KeyDown" Margin="0,0,8,0" />
                        <Button Grid.Column="1" Content="検索"
                                Background="#27AE60" Foreground="White" FontSize="16"
                                Padding="20,8" BorderThickness="0"
                                Command="{Binding AddItemCommand}"
                                Cursor="Hand" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Cart DataGrid -->
            <Border DockPanel.Dock="Top" Background="White" CornerRadius="8"
                    BorderBrush="#DDD" BorderThickness="1" Padding="4">
                <DataGrid x:Name="CartDataGrid" AutoGenerateColumns="False"
                          ItemsSource="{Binding CartItems}"
                          IsReadOnly="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                          BorderThickness="0" Background="White"
                          CanUserAddRows="False" CanUserDeleteRows="False"
                          SelectionMode="Single">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#34495E" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="商品名" Binding="{Binding Name}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="税率" IsReadOnly="True" Width="60">
                            <DataGridTextColumn.Binding>
                                <Binding Path="TaxRate" StringFormat="{}{0}%" />
                            </DataGridTextColumn.Binding>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="数量" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="15" TextAlignment="Center"
                                             BorderThickness="0" Background="Transparent"
                                             MinWidth="40" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="単価" Binding="{Binding UnitPrice, StringFormat=&#165;{0:N0}}" IsReadOnly="True" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="小計" Binding="{Binding LineTotalWithTax, StringFormat=&#165;{0:N0}}" IsReadOnly="True" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Padding" Value="4,2" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border />
        </DockPanel>

        <!-- RIGHT PANEL -->
        <Border Grid.Column="1" Background="White" CornerRadius="8"
                BorderBrush="#DDD" BorderThickness="1" Padding="20">
            <StackPanel>
                <TextBlock Text="お会計" FontSize="22" FontWeight="Bold"
                           Foreground="#2C3E50" Margin="0,0,0,16" />

                <!-- Subtotal -->
                <Border Background="#F8F9FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="小計" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding Subtotal, StringFormat=&#165;{0:N0}}" />
                    </Grid>
                </Border>

                <!-- 8% Taxable -->
                <Border Background="#F8F9FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="8%対象額" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TaxableAmount8, StringFormat=&#165;{0:N0}}" />
                    </Grid>
                </Border>
                <Border Background="#F8F9FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="消費税 (8%)" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TaxAmount8, StringFormat=&#165;{0:N0}}" />
                    </Grid>
                </Border>

                <!-- 10% Taxable -->
                <Border Background="#F8F9FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                    <Grid>
                        <TextBlock Text="10%対象額" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TaxableAmount10, StringFormat=&#165;{0:N0}}" />
                    </Grid>
                </Border>
                <Border Background="#F8F9FA" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                    <Grid>
                        <TextBlock Text="消費税 (10%)" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding TaxAmount10, StringFormat=&#165;{0:N0}}" />
                    </Grid>
                </Border>

                <!-- Total Banner -->
                <Border Background="#1A1A2E" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="合計" Foreground="White" FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#F39C12" FontSize="28"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   Text="{Binding TotalAmount, StringFormat=&#165;{0:N0}}" />
                    </Grid>
                </Border>

                <!-- Received Amount -->
                <TextBlock Text="預かり金額" FontSize="14" Foreground="#555" Margin="0,0,0,6" />
                <TextBox FontSize="20" Padding="12,8" Margin="0,0,0,12"
                         Text="{Binding ReceivedAmount, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center" />

                <!-- Change -->
                <Border Background="#EBF5FB" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="お釣り" Foreground="#2E86C1" FontSize="16"
                                   VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" Foreground="#2E86C1" FontSize="26"
                                   FontWeight="Bold" VerticalAlignment="Center"
                                   Text="{Binding Change, StringFormat=&#165;{0:N0}}" />
                    </Grid>
                </Border>

                <!-- Confirm Button -->
                <Button Content="会計確定" Background="#2E86C1" Foreground="White"
                        FontSize="18" FontWeight="Bold" Padding="0,14"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding ConfirmTransactionCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
